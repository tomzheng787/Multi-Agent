# Claude credentials: an API key, or nothing if you ran `ant auth login`.
ANTHROPIC_API_KEY=

# Redis for memory, evidence, checkpoints, message bus and job queue.
# Use fakeredis:// for an in-process (non-persistent) store.
REDIS_URL=redis://localhost:6379/0

# Identify yourself to the public data APIs (Nominatim requires it).
MC_HTTP_USER_AGENT=marketing-crew/0.1 (you@example.com)

# Optional tuning
# MC_MODEL=claude-opus-5-5
# MC_EFFORT=medium
# MC_MANAGER_EFFORT=high
# MC_VERIFIER_EFFORT=high
# MC_MAX_HALLUCINATION_RATE=0.10
# MC_GUARDRAIL_RETRIES=2
# MC_USE_FALLBACKS=true
# MC_OUTPUT_DIR=./outputs
